{
  "name": "kempo-products-inventory",
  "version": "0.2.2",
  "description": "Connects kempo-products to kempo-inventory: selling a product uses up the raw materials it is made from",
  "license": "MIT",
  "author": "Dustin Poissant <dustinpoissant@gmail.com>",
  "type": "module",
  "scripts": {
    "test": "node scripts/run-tests.js unit node --test --test-concurrency=1",
    "test:integration": "node scripts/run-tests.js integration node --test --test-concurrency=1",
    "link:local": "npm install ../kempo ../kempo-server ../kempo-ui ../kempo-products ../kempo-inventory --no-save --no-legacy-peer-deps --force",
    "docs:build": "node scripts/build-docs.js",
    "docs:dev": "npx kempo-server --root docs --port 4051"
  },
  "exports": {
    "./install": "./install.js",
    "./update": "./update.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dustinpoissant/kempo-products-inventory.git"
  },
  "peerDependencies": {
    "kempo": ">=4.9.10",
    "kempo-inventory": ">=0.4.0",
    "kempo-products": ">=0.2.0",
    "kempo-ui": ">=0.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "drizzle-kit": "^0.31.10",
    "postgres": "^3.4.9",
    "highlight.js": "^11.11.1"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "files": [
    "admin",
    "public",
    "server",
    "hooks",
    "install.js",
    "update.js",
    "kempo-config.json"
  ],
  "bugs": {
    "url": "https://github.com/dustinpoissant/kempo-products-inventory/issues"
  },
  "homepage": "https://github.com/dustinpoissant/kempo-products-inventory#readme"
}
