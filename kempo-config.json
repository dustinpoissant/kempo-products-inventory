{
  "docs": "https://github.com/dustinpoissant/kempo-products-inventory#readme",
  "git": "https://github.com/dustinpoissant/kempo-products-inventory",
  "public-scope": "products-inventory",
  "schema": "./server/db/schema.js",
  "dependencies": ["kempo-products", "kempo-inventory"],
  "hooks": {
    "kempo-products:purchase:recorded": "./hooks/purchase-recorded.js",
    "kempo-products:purchase:reversed": "./hooks/purchase-reversed.js",
